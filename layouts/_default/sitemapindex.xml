{{- "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $prodBaseURL := site.Params.canonicalBaseURL | default site.BaseURL -}}
{{- $prodBaseURL = strings.TrimSuffix "/" $prodBaseURL -}}
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- range . }}
  <sitemap>
    <loc>{{ $prodBaseURL }}/{{ .Language.Lang }}/sitemap.xml</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}
  </sitemap>
{{- end }}
</sitemapindex>
